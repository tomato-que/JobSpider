# ===== LLM 配置 =====
# 复制此文件为 .env 并填入你自己的信息

# 提供商: deepseek | anthropic | openai | openrouter | siliconflow
LLM_PROVIDER=

# 模型名称
# DeepSeek:    deepseek-chat / deepseek-reasoner
# Anthropic:   claude-sonnet-4-6 / claude-opus-4-7 / claude-haiku-4-5
# OpenAI:      gpt-4o / gpt-4o-mini
# OpenRouter:  deepseek/deepseek-chat
# SiliconFlow: deepseek-ai/DeepSeek-V3
LLM_MODEL=

# API Key — 根据上面选的提供商，填写对应的 Key
# DeepSeek  → DEEPSEEK_API_KEY
# Anthropic → ANTHROPIC_API_KEY
# OpenAI    → OPENAI_API_KEY
# OpenRouter→ OPENROUTER_API_KEY
# SiliconFlow→ SILICONFLOW_API_KEY
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# 通用 Key（优先级低于上面专属 Key）
LLM_API_KEY=

# 自定义 API 地址（使用代理或兼容接口时填写，不填则用官方地址）
LLM_BASE_URL=

# 是否启用 LLM (true/false)。关闭后回退纯脚本模式
LLM_ENABLED=false
